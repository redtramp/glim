{
  "name": "glim-reader",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "description": "A lightweight, fast, WYSIWYG Markdown desktop reader built with Tauri 2 + Svelte 5. Supports KaTeX, Mermaid, full-text search, and PDF/DOCX export.",
  "author": "Neilooo",
  "license": "MIT",
  "homepage": "https://github.com/redtramp/glim#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/redtramp/glim.git"
  },
  "bugs": {
    "url": "https://github.com/redtramp/glim/issues"
  },
  "keywords": [
    "markdown",
    "reader",
    "viewer",
    "desktop",
    "tauri",
    "svelte5",
    "tailwindcss",
    "rust",
    "katex",
    "mermaid",
    "pdf-export"
  ],
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --threshold error && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,svelte,css,json}\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-http": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "katex": "^0.17.0",
    "markdown-it": "^14.3.2",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.17.2",
    "svelte": "^5.57.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/svelte": "^5.4.2",
    "@types/jsdom": "^28.0.3",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-emoji": "^3.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
